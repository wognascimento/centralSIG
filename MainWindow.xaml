<Window x:Class="CentralSIG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="CENTRAL S.I.G - SISTEMA INTEGRADO DE GERENCIAMENTO"
        Height="600"
        Width="1024"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow">

    <Window.Resources>
        <Style x:Key="ModuleNameStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ModuleStatusStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="ModuleCardStyle" TargetType="Border">
            <Setter Property="Height" Value="86" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.02" ScaleY="1.02" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <telerik:RadMenu Grid.Row="0" Margin="-14,-14,-14,10">
            <telerik:RadMenuItem Header="Outros">
                <telerik:RadMenuItem Header="Atualizar Sistema" Click="OnAtualizarSistemaClick"/>
                <telerik:RadMenuItem Header="Sobre" Click="OnSobreSistemaClick"/>
            </telerik:RadMenuItem>
        </telerik:RadMenu>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Central S.I.G."
                       FontFamily="Segoe UI Light"
                       FontSize="34"
                       Foreground="#FF333333" />
            <telerik:Label Content="Clique no módulo para abrir o sistema"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           Foreground="#FF666666"
                           Padding="0,4,0,18" />
        </StackPanel>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Modules}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Brush}"
                            Style="{StaticResource ModuleCardStyle}"
                            MouseLeftButtonUp="OnModuleMouseDown">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Name}"
                                       Style="{StaticResource ModuleNameStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Status}"
                                       Style="{StaticResource ModuleStatusStyle}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="3"
                   Text="{Binding SigRoot, StringFormat=Diretório dos módulos: {0}}"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   Foreground="#FF777777"
                   Margin="10,12,10,0" />
    </Grid>
</Window>
